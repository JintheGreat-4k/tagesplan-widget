<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau in der Widget-Auswahl (Beispieltexte) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aufgaben"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 offen · 1 fällig"
        android:textColor="@color/ink3"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Fokus"
        android:textColor="@color/ink2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_kreis"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Rechnung zahlen"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_kreis"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Bewerbung abschicken"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_haken"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Lager planen"
        android:textColor="@color/ink3"
        android:textSize="14sp" />
</LinearLayout>
