<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tagesplan Widget"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/meldung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Aus dem Link im Lifehub: Widget-Code bestätigen -->
        <LinearLayout
            android:id="@+id/box_verbinden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/verbinden_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/code_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_verbinden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verbinden" />

                <Button
                    android:id="@+id/btn_abbrechen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Abbrechen" />
            </LinearLayout>
        </LinearLayout>

        <!-- Widget-Code von Hand eintippen. Immer da (ausser während der Frage oben), auch wenn verbunden:
             Titel und Text setzt MainActivity je nachdem, ob schon verbunden. -->
        <LinearLayout
            android:id="@+id/box_einrichten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/getrennt_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/spaet"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/einrichten_titel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mit dem Lifehub verbinden"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/einrichten_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Im Lifehub auf dem Handy: Tagesplan → Zahnrad → «Widget-App verbinden» → «Widget-App öffnen». Diese App fragt dann «Mit dem Lifehub verbinden?»: «Verbinden» antippen. Oder hier den Widget-Code eintippen und «Mit Code verbinden» antippen."
                android:textSize="15sp" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/code"
                android:text="Widget-Code (8 Zeichen)"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="z. B. ABCD-EFGH"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="40" />

            <Button
                android:id="@+id/btn_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mit Code verbinden" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/box_widgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Widgets auf den Startbildschirm"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Knopf antippen und «Hinzufügen» bestätigen. Oder lange auf eine freie Stelle des Startbildschirms drücken → Widgets → «Tagesplan Widget». Für einen Stapel: ein Widget auf ein anderes gleich grosses ziehen."
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_kalender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kalender-Widget hinzufügen" />

            <Button
                android:id="@+id/btn_aufgaben"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aufgaben-Widget hinzufügen" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Im Hintergrund aktualisieren"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/akku_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_akku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Akku nicht einschränken" />

            <Button
                android:id="@+id/btn_jetzt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jetzt aktualisieren" />

            <Button
                android:id="@+id/btn_trennen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verbindung trennen" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0.6"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
