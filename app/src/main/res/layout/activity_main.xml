<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tagesplan Widget"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/meldung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/box_verbinden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/verbinden_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_verbinden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Verbinden" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/box_einrichten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verbinden"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Öffne die App «Marcs Tagesplan», tippe aufs Zahnrad und wähle «Widget-App verbinden». Danach kommst du hierher zurück und tippst «Verbinden»."
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Oder den Einrichtungslink einfügen (beginnt mit https://jinthegreat-4k.github.io/tagesplan/#u=):"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Einrichtungslink"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btn_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mit Link verbinden" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/box_widgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Widgets auf den Startbildschirm"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Knopf antippen und «Hinzufügen» bestätigen. Oder lange auf eine freie Stelle des Startbildschirms drücken → Widgets → «Tagesplan Widget». Für einen Stapel: ein Widget auf ein anderes gleich grosses ziehen."
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_kalender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kalender-Widget hinzufügen" />

            <Button
                android:id="@+id/btn_aufgaben"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aufgaben-Widget hinzufügen" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Im Hintergrund aktualisieren"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/akku_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_akku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Akku nicht einschränken" />

            <Button
                android:id="@+id/btn_jetzt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jetzt aktualisieren" />

            <Button
                android:id="@+id/btn_trennen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verbindung trennen" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0.6"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
