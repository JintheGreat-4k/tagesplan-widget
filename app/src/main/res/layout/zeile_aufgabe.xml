<?xml version="1.0" encoding="utf-8"?>
<!-- Kreis links: abhaken. Text: in der App öffnen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/haken"
        android:layout_width="48dp"
        android:layout_height="46dp"
        android:background="@drawable/knopf_hg"
        android:paddingStart="12dp"
        android:paddingTop="11dp"
        android:paddingEnd="12dp"
        android:paddingBottom="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_kreis" />

    <LinearLayout
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/zeile_hg"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/titel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="14.5sp" />

        <LinearLayout
            android:id="@+id/unten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/punkt"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/punkt" />

            <TextView
                android:id="@+id/frist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/ink2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
